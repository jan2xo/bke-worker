# Copy to ~/.config/bke-worker/bke-worker.env and chmod 600.
# Never place ChatGPT cookies, OAuth tokens, browser storage, or passwords here.

# UTM/dev operator surface. Keep Chromium CDP separately loopback-only.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Notion project selection is UI-owned.
# Worker discovers shared pages whose title starts with ENGINEERING:.
# Page names are display/discovery only; the exact selected page ID is locked at START.
# Each selected page may contain:
#   - normal to_do blocks = executable tasks
#   - one or more normal tables using header: KEY | NAME | INSTRUCTION
BKE_WORKER_NOTION_TOKEN=REPLACE_ME
BKE_WORKER_NOTION_BASE_URL=https://api.notion.com/

# BKE Worker owns one deterministic ChatGPT conversation.
# Accepted shape: https://chatgpt.com/.../c/<conversation-id>
BKE_WORKER_CHATGPT_OVERRIDE_URL=""
BKE_WORKER_CHATGPT_BASE_URL=https://chatgpt.com/

# Live chatgpt.com is CDP-attach only. Keep this loopback-only.
BKE_WORKER_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BKE_WORKER_CHATGPT_PROFILE=$HOME/snap/chromium/common/bke-worker-chatgpt-profile
BKE_WORKER_HEADLESS=false

# Watch exact current Notion to_do block frequently.
# If unchecked + ChatGPT busy => wait.
# If unchecked + ChatGPT idle for the retry window => continue the same TODO.
# If checked => dispatch the next unchecked TODO on the locked page.
# If no unchecked TODOs remain => COMPLETE.
BKE_WORKER_WATCHDOG_SECONDS=2
BKE_WORKER_IDLE_RETRY_SECONDS=5

BKE_WORKER_STATE_FILE=$HOME/.local/share/bke-worker/state/notion-watchdog.json
