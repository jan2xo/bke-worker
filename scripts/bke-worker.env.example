# Copy once per worker, for example:
#   ~/.config/bke-worker/worker-a.env
# Keep each file chmod 600.
# Never place ChatGPT cookies, OAuth tokens, browser storage, or passwords here.

# Stable worker identity. GitHub PR assignment label:
#   bke-worker:<worker_id>
BKE_WORKER_ID=worker-a

# Every worker instance needs a distinct loopback listen address/port.
ASPNETCORE_URLS=http://127.0.0.1:5084

# Canonical autonomous engineering target.
# Concurrent workers MUST use different ChatGPT targets.
# Choose exactly one mode:
#   A) Project + Conversation
#   B) direct Override Link
#   C) neither -> New Chat (deliberate experiments only)
BKE_WORKER_CHATGPT_PROJECT="BKE Worker"
BKE_WORKER_CHATGPT_CONVERSATION="Worker Engineering A"

# Accepted override shape: https://chatgpt.com/.../c/<conversation-id>
BKE_WORKER_CHATGPT_OVERRIDE_URL=""

BKE_WORKER_CHATGPT_BASE_URL=https://chatgpt.com/

# Live chatgpt.com is CDP-attach only.
# Every worker MUST use a distinct loopback CDP endpoint and writable profile.
BKE_WORKER_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BKE_WORKER_CHATGPT_PROFILE=$HOME/snap/chromium/common/bke-worker-worker-a-chatgpt-profile
BKE_WORKER_HEADLESS=false

# Optional browser-native bridge. When set, start-chatgpt-browser.sh loads the
# built unpacked extension into this worker\'s exact persistent Chromium profile.
# Build it first with: (cd browser-extension && npm install && npm run check)
BKE_WORKER_BROWSER_EXTENSION_PATH=$HOME/bke/bke-worker/browser-extension

# Configure the GitHub repository webhook to send both push and pull_request
# events. The PR's single bke-worker:<worker_id> label is the durable assignment.
BKE_WORKER_GITHUB_WEBHOOK_SECRET=REPLACE_ME

# Per-worker liveness cache only. GitHub remains assignment/task truth.
BKE_WORKER_STATE_FILE=$HOME/.local/share/bke-worker/state/worker-a.json

# Shared host-local lock directory. All worker instances on the same host must
# point here so duplicate worker IDs, ChatGPT targets, profiles, state files,
# or CDP endpoints fail closed.
BKE_WORKER_RESOURCE_LOCK_DIRECTORY=$HOME/.local/share/bke-worker/locks

BKE_WORKER_WEBHOOK_DEBOUNCE_SECONDS=10

# Recovery/liveness heartbeat. Default: 30 minutes.
BKE_WORKER_HEARTBEAT_SECONDS=1800

# Prevent accidental duplicate continuation sends during a short event burst.
BKE_WORKER_MIN_DISPATCH_SECONDS=30
