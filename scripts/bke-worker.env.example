# Copy to ~/.config/bke-worker/bke-worker.env and chmod 600.
# Never place ChatGPT cookies, OAuth tokens, browser storage, passwords, Notion secrets,
# or deterministic ChatGPT conversation URLs here.

# UTM/dev operator surface. Keep Chromium CDP separately loopback-only.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Notion authentication and project selection are UI-owned.
# Enter the Notion integration secret in the operator UI after Worker starts.
BKE_WORKER_NOTION_BASE_URL=https://api.notion.com/

# Exact ChatGPT conversation selection is also UI-owned.
# Paste the deterministic https://chatgpt.com/.../c/<conversation-id> URL in the UI.
# It is held in process memory only and discarded on clear/restart.
BKE_WORKER_CHATGPT_BASE_URL=https://chatgpt.com/

# Live chatgpt.com is CDP-attach only. Keep this loopback-only.
BKE_WORKER_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BKE_WORKER_CHATGPT_PROFILE=$HOME/snap/chromium/common/bke-worker-chatgpt-profile
BKE_WORKER_HEADLESS=false

BKE_WORKER_WATCHDOG_SECONDS=2
BKE_WORKER_IDLE_RETRY_SECONDS=5
BKE_WORKER_STATE_FILE=$HOME/.local/share/bke-worker/state/notion-watchdog.json
