# Copy to ~/.config/bke-worker/bke-worker.env and chmod 600.
# Never place ChatGPT cookies, OAuth tokens, browser storage, or passwords here.

ASPNETCORE_URLS=http://127.0.0.1:5084

BKE_WORKER_NOTION_TOKEN=REPLACE_ME
BKE_WORKER_NOTION_PAGE=REPLACE_ME
BKE_WORKER_NOTION_BASE_URL=https://api.notion.com/

# ChatGPT target selection is mutually exclusive:
#   A) Project + Conversation
#   B) direct Override Link
#   C) neither -> New Chat
# New Chat is the only implicit/default target.
# There is NO Override -> Project+Chat or Project+Chat -> Override fallback.

# Mode A — semantic Project + Conversation.
# Clear both fields when using Mode B or Mode C.
BKE_WORKER_CHATGPT_PROJECT="BKE Worker"
BKE_WORKER_CHATGPT_CONVERSATION="Worker Engineering"

# Mode B — direct conversation link.
# Clear Project + Conversation when using this mode.
# Accepted shape: https://chatgpt.com/.../c/<conversation-id>
BKE_WORKER_CHATGPT_OVERRIDE_URL=""

# Mode C — New Chat: leave Project, Conversation, and Override URL all empty.

BKE_WORKER_CHATGPT_BASE_URL=https://chatgpt.com/

# Live chatgpt.com is CDP-attach only. Keep this loopback-only.
BKE_WORKER_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BKE_WORKER_CHATGPT_PROFILE=$HOME/snap/chromium/common/bke-worker-chatgpt-profile
BKE_WORKER_HEADLESS=false

BKE_WORKER_GITHUB_WEBHOOK_SECRET=REPLACE_ME
BKE_WORKER_STATE_FILE=$HOME/.local/share/bke-worker/state/worker.json

BKE_WORKER_WEBHOOK_DEBOUNCE_SECONDS=10
BKE_WORKER_RECOVERY_SECONDS=300
BKE_WORKER_MIN_DISPATCH_SECONDS=30
