<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../BKE.Worker.Core/BKE.Worker.Core.csproj" />
    <ProjectReference Include="../BKE.Worker.ChatGPT/BKE.Worker.ChatGPT.csproj" />
    <ProjectReference Include="../BKE.Worker.Notion/BKE.Worker.Notion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs serves static files from AppContext.BaseDirectory/wwwroot.
         Keep the operator UI beside the built/published server so `GET /`
         works identically under `dotnet run`, direct DLL execution, and publish. -->
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
