{
  "name": "@bke/worker-browser-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-manifest.mjs",
    "check": "npm run build && npm run validate && npm test && npm run test:native && npm run test:host-claim",
    "test:native": "node --test native-host/tests/*.test.mjs",
    "smoke:native": "npm run build && node scripts/run-desktop-native-smoke.mjs",
    "test:host-claim": "tsc -p ../native-host/tsconfig.json && node --test ../native-host/tests/*.test.mjs"
  }
}
