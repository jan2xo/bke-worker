[Unit]
Description=BKE Worker VPS Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bke-worker
Group=bke-worker
WorkingDirectory=/opt/bke-worker
EnvironmentFile=/etc/bke-worker/bke-worker.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
ExecStart=/usr/bin/dotnet /opt/bke-worker/BKE.Worker.Server.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
